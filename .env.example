# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# # Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT ---------------------------------
APP_ENV=local
FRONTEND_BASE_URL=http://localhost:5173
# Compose creates and reuses .local/secrets/auth/jwt-signing-private.pem by default.
# Set this only for a different key path inside the user-service container.
JWT_PRIVATE_KEY_FILE=
JWT_ACCESS_TOKEN_TTL=10m
JWT_REFRESH_TOKEN_TTL=720h
# Required by User Service and Order Service when publishing Kafka events.
KAFKA_BROKERS=localhost:9092
# First super_admin, created or promoted on startup. Ignored once bootstrapped.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_DISPLAY_NAME= admin

# ---- Email (Mailpit locally) --------------------------------
# Communication Service sends all email (magic links, and order notifications
# to users without Telegram); Compose routes it to Mailpit (UI:
# http://localhost:8025). Leave SMTP_ADDR empty to use mailpit:1025 in Compose.
SMTP_ADDR=
SMTP_FROM=FoC <no-reply@foc.local>
# Optional credentials for a real relay; Mailpit needs none.
SMTP_USERNAME=
SMTP_PASSWORD=
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---- Telegram (Communication Service) ------------------------
# Optional. Create your own test bot with @BotFather; Telegram allows only
# one poller per bot, so don't share a token with teammates.
TELEGRAM_BOT_TOKEN=
# Public t.me link to the same bot, used by the frontend Chat button.
PUBLIC_TELEGRAM_BOT_URL=

# ---- Postgres (single shared dev server, one DB per service) --
POSTGRES_USER=foc
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
USER_DB=user_dev
SUPPLIER_DB=supplier_dev
ORDER_DB=order_dev
CREDIT_DB=credit_dev
COMMUNICATION_DB=communication_dev
MODERATION_DB=moderation_dev

# ---- Service ports (host side) --------------------------------
# Host ports mapped to the app's PORT inside each container.
USER_PORT=8081
SUPPLIER_PORT=8082
ORDER_PORT=8083
COMMUNICATION_PORT=8084
# Credit's public listener. Internal service listeners are never published.
CREDIT_PORT=8085
# Content moderation service public listener.
MODERATION_PORT=8086
FRONTEND_PORT=5173
# Kafka broker for host clients, and the operator UI's published port
# (note: K8S_KAFKA_UI_PORT below defaults to the same port — run one stack at a time).
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
# Browser-facing API URL. Empty uses localhost and USER_PORT in Compose.
PUBLIC_USER_SERVICE_URL=
# Browser-facing Supplier Service URL. Empty uses localhost and SUPPLIER_PORT.
PUBLIC_SUPPLIER_SERVICE_URL=
# Browser-facing Communication Service URL. Empty uses localhost and COMMUNICATION_PORT.
PUBLIC_COMMUNICATION_SERVICE_URL=
# Browser-facing Content Moderation Service URL. Empty uses localhost and MODERATION_PORT.
PUBLIC_MODERATION_SERVICE_URL=
# If FRONTEND_PORT changes, update FRONTEND_BASE_URL above to match.

# ---- Kubernetes local port-forwarding -------------------------
# Kubernetes and Compose use some of the same host ports; run only one stack
# at a time. Empty values disable the corresponding Kubernetes forward.
# `make k8s-up` starts configured forwards and stays attached until Ctrl+C.
K8S_HTTPS_PORT=5173
K8S_KAFKA_UI_PORT=8080
K8S_MAILPIT_PORT=8025
K8S_GRAFANA_PORT=3000
# Optional first-run Telegram credential; later edits use the private state file.
K8S_TELEGRAM_BOT_TOKEN=
# First superadmin: the deploy script patches this into foc-config. Empty
# (or unset) creates no superadmin.
K8S_BOOTSTRAP_SUPERADMIN_EMAIL=
# Optional display name for the bootstrap admin (defaults to Admin).
#K8S_BOOTSTRAP_SUPERADMIN_DISPLAY_NAME=Admin
# Never set K8S_CONFIRM_DELETE in this file: it would skip the deletion
# guard of make k8s-delete-cluster.

# ---- Service DB URLs (as seen from inside compose network) ----
# Percent-encode reserved characters in the password portion of these URLs.
USER_DATABASE_URL=postgresql://foc:changeme@postgres:5432/user_dev?sslmode=disable
SUPPLIER_DATABASE_URL=postgresql://foc:changeme@postgres:5432/supplier_dev?sslmode=disable
ORDER_DATABASE_URL=postgresql://foc:changeme@postgres:5432/order_dev?sslmode=disable
COMMUNICATION_DATABASE_URL=postgresql://foc:changeme@postgres:5432/communication_dev?sslmode=disable
CREDIT_DATABASE_URL=postgresql://foc:changeme@postgres:5432/credit_dev?sslmode=disable
MODERATION_DATABASE_URL=postgresql://foc:changeme@postgres:5432/moderation_dev?sslmode=disable

# ---- Service-to-service addresses (internal) ------------------
# Backend services call each other over the Compose network; browsers never
# see these addresses. User's public-key RPC lives on its INTERNAL listener
# (8081), so internal callers must not use the public port 8080.
USER_SERVICE_BASE_URL=http://user-service:8081
# Order-only settings. Set ORDER_SUPPLIER_SERVICE_URL only to override the
# Supplier discovery default. Set CREDIT_SERVICE_BASE_URL empty to run Order
# without Credit (order creation disabled).
ORDER_SUPPLIER_SERVICE_URL=
CREDIT_SERVICE_BASE_URL=http://credit-service:8081

# ---- Per-service runtime --------------------------------------
# Every Go service runs the listener split: PORT serves public routes and
# INTERNAL_PORT serves private routes. Services without private routes yet
# still bind the internal listener so local and deployed behaviour match.
# Compose publishes only PORT to the host; internal listeners are never
# published.
PORT=8080
INTERNAL_PORT=8081
DATABASE_URL=
# Order applies embedded migrations on startup unless disabled.
RUN_MIGRATIONS=true
# ... Add more variables as needed

ORDER_S3_BUCKET=order-images
FLOCI_PORT=4566

# OpenAI-compatible inference endpoint and key. The key is a backend secret:
# never put it in PUBLIC_* variables, git or seed fixtures. An empty key (and
# an endpoint that needs one) starts CMS degraded: submissions queue, admin
# APIs and setup status keep working, and no inference attempts are burned.
CMS_LLM_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
CMS_LLM_API_KEY=
# Per-process worker pool and retry tuning (defaults shown; see the runbook).
#CMS_WORKER_CONCURRENCY=2
#CMS_LLM_REQUEST_TIMEOUT=120s
#CMS_JOB_LEASE=180s
#CMS_JOB_HEARTBEAT_INTERVAL=10s
#CMS_JOB_MAX_ATTEMPTS=5
#CMS_JOB_RETRY_INITIAL_DELAY=10s
#CMS_JOB_RETRY_MAX_DELAY=5m
#CMS_JOB_POLL_INTERVAL=1s
#CMS_OPERATIONAL_STATE_INTERVAL=5m
