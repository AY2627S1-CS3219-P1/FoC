DATABASE_URL=
# Optional: pool size and startup migrations (defaults shown).
# DB_MAX_OPEN=10
# DB_MAX_IDLE=5
# RUN_MIGRATIONS=true
APP_ENV=local
PORT=8080
INTERNAL_PORT=8081
FRONTEND_BASE_URL=http://localhost:5173
# Compose creates and reuses ../.local/secrets/auth/jwt-signing-private.pem.
# `make run` expects the key to exist. Required outside development.
JWT_PRIVATE_KEY_FILE=
JWT_ACCESS_TOKEN_TTL=10m
JWT_REFRESH_TOKEN_TTL=720h
# Communication Service's internal listener, which sends magic links. With
# APP_ENV=local it defaults to the Compose address.
# COMMUNICATION_SERVICE_BASE_URL=http://communication-service:8081
# First super_admin, created or promoted on startup (display name
# defaults to Admin). Ignored once an admin has been bootstrapped.
# BOOTSTRAP_SUPERADMIN_EMAIL= admin@example_email.com
# BOOTSTRAP_SUPERADMIN_DISPLAY_NAME= admin
