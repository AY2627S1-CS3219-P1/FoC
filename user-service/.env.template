DATABASE_URL=
# Local Kafka listener. Compose overrides this with kafka:9092.
KAFKA_BROKERS=localhost:9092
# Optional: pool size and startup migrations (defaults shown).
# DB_MAX_OPEN=10
# DB_MAX_IDLE=5
# RUN_MIGRATIONS=true
APP_ENV=local
PORT=8080
INTERNAL_PORT=8081
FRONTEND_BASE_URL=http://localhost:5173
# Compose creates and reuses ../.local/secrets/auth/jwt-signing-private.pem.
# `make run` expects the key to exist. Required outside development.
JWT_PRIVATE_KEY_FILE=
JWT_ACCESS_TOKEN_TTL=10m
JWT_REFRESH_TOKEN_TTL=720h
# Magic-link email. With APP_ENV=local these default to Mailpit on
# localhost:1025 (`docker compose up mailpit`). Required outside development.
SMTP_ADDR=localhost:1025
SMTP_FROM=FoC <no-reply@foc.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TIMEOUT=5s
# First super_admin, created or promoted on startup (display name
# defaults to Admin). Ignored once an admin has been bootstrapped.
# BOOTSTRAP_SUPERADMIN_EMAIL= admin@example_email.com
# BOOTSTRAP_SUPERADMIN_DISPLAY_NAME= admin
# Review photo storage (optional). Without USER_S3_BUCKET the photo RPCs
# report unavailability and reviews submit without photos. Compose creates
# and initializes the user-images bucket via the user-storage-init service.
# USER_S3_BUCKET=user-images
# USER_S3_ENDPOINT=http://floci:4566
# USER_S3_PUBLIC_ENDPOINT=http://localhost:4566
# Presigned grant lifetimes. Omit for the adapter defaults (10m upload, 5m
# download).
# USER_S3_UPLOAD_TTL=10m
# USER_S3_DOWNLOAD_TTL=5m
