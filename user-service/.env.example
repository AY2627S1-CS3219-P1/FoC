DATABASE_URL=postgres://user_svc:user_svc@localhost:5433/users?sslmode=disable
HTTP_ADDR=:8080
RUN_MIGRATIONS=true

# Magic links point at the frontend, which POSTs the token back.
APP_BASE_URL=http://localhost:5173
SESSION_TTL=720h
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=true
LINK_LIMIT_PER_EMAIL=5
LINK_LIMIT_PER_IP=20

# Mailpit locally; swap for SES SMTP creds in prod.
SMTP_ADDR=localhost:1025
MAIL_FROM=no-reply@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
