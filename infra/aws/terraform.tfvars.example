# Copy to terraform.tfvars (ignored). No credentials belong in this file.
account_id      = "123456789012"
name            = "foc-demo"
region          = "ap-southeast-1"
operator_cidr   = "203.0.113.10/32" # Replace with your public IPv4 /32.
public_hostname = "foc.example.com" # Replace with a hostname you control.
expires_on      = "2026-11-16"      # Replace with seven days after actual deployment.

# Confirm regional availability, sandbox permissions, and pricing before apply.
kubernetes_version      = "1.35"
postgres_version        = "18"
postgres_instance_class = "db.t4g.small"
