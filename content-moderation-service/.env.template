# Database
DATABASE_URL=postgresql://cms_user:cms_pass@localhost:5432/cms_dev?sslmode=disable

# User Service
USER_SERVICE_URL=http://user-service:8080

# Listeners
PORT=8080
INTERNAL_PORT=8081

# Run migrations on startup
RUN_MIGRATIONS=true

# Kafka
# KAFKA_BROKERS=localhost:9092

# LLM Provider
CMS_LLM_API_KEY=your-api-key-here
CMS_LLM_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1

# Worker pool
CMS_WORKER_CONCURRENCY=2

# Job settings
CMS_JOB_LEASE=180s
CMS_JOB_HEARTBEAT_INTERVAL=10s
CMS_JOB_MAX_ATTEMPTS=5
CMS_JOB_RETRY_INITIAL_DELAY=10s
CMS_JOB_RETRY_MAX_DELAY=5m
CMS_JOB_POLL_INTERVAL=1s
