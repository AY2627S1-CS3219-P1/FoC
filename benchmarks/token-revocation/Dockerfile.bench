# Standalone benchmark image: pure Go, CGO disabled, no runtime dependencies.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY go.sum ./
COPY . .
RUN CGO_ENABLED=0 GOFLAGS=-mod=readonly go build -o /benchmark ./

FROM alpine:3.21
RUN apk add --no-cache ca-certificates bash
COPY --from=build /benchmark /benchmark
WORKDIR /app
ENTRYPOINT ["/benchmark"]
