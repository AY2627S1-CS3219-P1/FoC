# Dev image with live reload via Air. Used by compose.yaml.
FROM golang:1.26

WORKDIR /app

RUN go install github.com/air-verse/air@latest

COPY pkg /pkg
COPY supplier-service/go.mod supplier-service/go.sum ./
RUN go mod download

COPY supplier-service/ .

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
