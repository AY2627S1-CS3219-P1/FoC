# Dev image with live reload via Air. Used by compose.yaml.
FROM golang:1.26

WORKDIR /app

RUN go install github.com/air-verse/air@latest
RUN go install github.com/pressly/goose/v3/cmd/goose@latest

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080

CMD ["sh", "-c", "goose -dir database/schema postgres \"$DATABASE_URL\" up && exec air -c .air.toml"]
