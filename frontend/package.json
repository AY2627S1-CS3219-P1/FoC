{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"buf:lint": "cd .. && buf lint",
		"buf:generate": "cd .. && buf generate"
	},
	"devDependencies": {
		"@bufbuild/protoc-gen-es": "2.15.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-functions-mixins": "file:vendor/vite-plugin-functions-mixins",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.15.0",
		"@connectrpc/connect": "^2.2.0",
		"@connectrpc/connect-web": "^2.2.0",
		"m3-svelte": "^7.2.1",
		"sveltekit-superforms": "^2.31.0",
		"valibot": "^1.5.0",
		"zod": "^4.6.5"
	},
	"optionalDependencies": {
		"class-validator": "^0.14.4"
	}
}
