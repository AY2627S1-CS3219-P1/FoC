{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:wireframe": "node scripts/check-wireframe.mjs",
		"test:realtime": "node scripts/check-realtime.mjs",
		"test:profile-pictures": "node scripts/check-profile-pictures.mjs",
		"buf:lint": "cd .. && buf lint",
		"buf:generate": "cd .. && buf generate",
		"test:proximity": "node scripts/check-proximity.mjs",
		"test:moderation": "node scripts/check-moderation.mjs"
	},
	"devDependencies": {
		"@bufbuild/protoc-gen-es": "2.15.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/leaflet": "^1.9.22",
		"class-validator": "^0.14.4",
		"playwright": "1.64.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-functions-mixins": "file:vendor/vite-plugin-functions-mixins",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.15.0",
		"@connectrpc/connect": "^2.2.0",
		"@connectrpc/connect-web": "^2.2.0",
		"@ktibow/iconset-material-symbols": "~0.0.1764827375",
		"leaflet": "^1.9.4",
		"libphonenumber-js": "^1.13.15",
		"m3-svelte": "^7.2.1",
		"svelte-tel-input": "^4.3.4",
		"sveltekit-superforms": "^2.31.0",
		"valibot": "^1.5.0",
		"zod": "^4.6.5"
	}
}
